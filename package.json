{
  "name": "table-flow",
  "version": "0.1.0",
  "private": true,
  "description": "TableFlow — real-time poker table state derivation + GTO/EV recommendation",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "yarn workspace @table-flow/desktop dev",
    "build": "yarn workspace @table-flow/desktop build",
    "typecheck": "yarn workspaces run typecheck",
    "lint": "yarn workspaces run lint",
    "build:native": "cargo build --release -p tf-napi"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@1.22.22"
}
